    }

    .button {
      display: inline-block;
      background: #f5c400;
      color: #000;
      padding: 14px 25px;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
      margin: 5px;
    }

    section {
      padding: 50px 20px;
      text-align: center;
    }

    section h2 {
      color: #f5c400;
      font-size: 30px;
      margin-bottom: 30px;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 18px;
      max-width: 900px;
      margin: auto;
    }

    .service {
      background: #1d1d1d;
      padding: 25px;
      border-radius: 12px;
      border: 1px solid #333;
    }

    .service h3 {
      color: #f5c400;
